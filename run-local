#!/usr/bin/env python3
"""Run the source checkout with a private local asset server (no Apache/sudo)."""
import functools
import http.server
import os
from pathlib import Path
import subprocess
import sys
import threading

root = Path(__file__).resolve().parent
if not (root / "src/bin/vreng").is_file():
    sys.exit("Build VREng first: ./build")
if not os.environ.get("DISPLAY"):
    sys.exit("DISPLAY is unset. Run in WSLg or an X11 desktop session.")
class Assets(http.server.SimpleHTTPRequestHandler):
    def log_message(self, fmt, *args):
        if os.environ.get("VRENG_HTTP_LOG"):
            super().log_message(fmt, *args)

handler = functools.partial(Assets, directory=str(root / "data"))
with http.server.ThreadingHTTPServer(("127.0.0.1", 0), handler) as server:
    server.daemon_threads = True
    threading.Thread(target=server.serve_forever, daemon=True).start()
    url = f"http://127.0.0.1:{server.server_port}/"
    print(f"VREng local assets: {url}", flush=True)
    env = os.environ.copy()
    env.setdefault("VRENG_HOME", str(root / ".local-state"))
    # Loopback data must bypass any inherited Internet proxy.
    for key in ("http_proxy", "HTTP_PROXY", "https_proxy", "HTTPS_PROXY"):
        env.pop(key, None)
    try:
        result = subprocess.call([str(root / "vr"), "-M", "-N", "-u", url, *sys.argv[1:]], cwd=root, env=env)
    except KeyboardInterrupt:
        result = 130
    finally:
        server.shutdown()
sys.exit(result)
