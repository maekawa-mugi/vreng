#!/bin/sh
# Launch from the source tree, independently of the caller's working directory.
set -eu
cd -- "$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
if [ ! -x src/bin/vreng ]; then
    echo "Build VREng first: ./build" >&2
    exit 1
fi
if [ "${1:-}" = -D ]; then
    shift
    if command -v gdb >/dev/null 2>&1; then
        exec gdb --args ./src/bin/vreng "$@"
    fi
    exec lldb -- ./src/bin/vreng "$@"
fi
exec ./src/bin/vreng "$@"
